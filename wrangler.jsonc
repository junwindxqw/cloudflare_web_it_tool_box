{
  // Cloudflare Workers 配置 —— 静态资源 + API 代理
  // 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-it-tool-box",
  "compatibility_date": "2026-08-30",
  "main": "./src/worker.js",
  // 自定义域名：需 junwind.site 的 DNS 托管在同一 Cloudflare 账号
  // 部署时 Cloudflare 会自动创建 DNS 记录并签发证书
  "routes": [
    { "pattern": "web-it-tool-box.junwind.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
